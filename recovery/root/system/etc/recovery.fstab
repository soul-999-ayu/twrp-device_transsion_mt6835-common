# TWRP fstab for Tecno KL8h
# Converted from stock fstab.
# The 'logical' flag is essential for dynamic partitions to appear in the partition manager.

#<mnt_point>      <type>    <device>                                    <flags>
/boot             emmc      /dev/block/by-name/boot                     flags=display="Boot";backup=1
/vendor_boot      emmc      /dev/block/by-name/vendor_boot              flags=display="Vendor Boot";backup=1
/misc             emmc      /dev/block/by-name/misc                     flags=display="Misc";backup=0
/cache            ext4      /dev/block/by-name/tranfs                   flags=display="Cache";backup=0;wipeingui
/metadata         f2fs      /dev/block/by-name/metadata                 flags=display="Metadata";backup=1
/data             f2fs      /dev/block/by-name/userdata                 flags=display="Data";backup=1;fileencryption=ice

# Super partition and its logical partitions
/super            emmc      /dev/block/by-name/super                    flags=display="Super";backup=1;flashimg=1

/system           erofs     system                                      flags=display="System";backup=1;logical
/system_ext       erofs     system_ext                                  flags=display="System_Ext";backup=1;logical
/product          erofs     product                                     flags=display="Product";backup=1;logical
/vendor           erofs     vendor                                      flags=display="Vendor";backup=1;logical
/vendor_dlkm      erofs     vendor_dlkm                                 flags=display="Vendor_DLKM";backup=1;logical
/odm_dlkm         erofs     odm_dlkm                                    flags=display="ODM_DLKM";backup=1;logical
/system_dlkm      erofs     system_dlkm                                 flags=display="System_DLKM";backup=1;logical
